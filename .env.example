# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ldr_date

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000

# LangSmith (optional for Phase 0, required for agent tracing)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ldr-date-planner

# Model provider (used from Phase 3 onwards)
ANTHROPIC_API_KEY=

# Twilio (used from Phase 4 onwards)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Calendar providers (used from Phase 1 onwards)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback